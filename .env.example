# Copy to .env.local and fill in. Never commit real values.
# Klaviyo private key for the contact-form forward (server-side only; in
# production it is a Wrangler secret, never an env var in a bundle).
KLAVIYO_API_KEY=
# The Klaviyo list that demo requests are added to.
KLAVIYO_DEMO_LIST_ID=
SITE_URL=http://localhost:3000
