{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pour-iq",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "kv_namespaces": [
    // Contact-form rate limiting only (ephemeral counters keyed by a
    // hash of the IP, 10-minute TTL). No user data lives here.
    {
      "binding": "RATE_LIMIT",
      "id": "72d08fac2c76440c948cc447999cd93e",
    },
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
    },
  },
}
